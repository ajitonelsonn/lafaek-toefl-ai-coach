# Copy to .env.local for development. Put real values in .env.local or your
# hosting provider's secret settings — never in this file or in git.
# Variables without NEXT_PUBLIC_ are server-only and never reach the browser.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LafaekTOEFL AI Coach

# PostgreSQL (Render external URL for local/Vercel; include sslmode=require)
DATABASE_URL=

# Sessions and OTP
AUTH_SECRET=                  # 48+ random bytes, e.g. `openssl rand -base64 48`
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SESSION_TTL_DAYS=30
# One study plan (and so one AI generation batch) per account per this many days
STUDY_PLAN_COOLDOWN_DAYS=30

# Gmail SMTP via Nodemailer (use an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AWS S3 (private bucket, least-privilege IAM user)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# Meta Model API (text, images, speech-to-text)
MODEL_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
# Used when Meta answers model_not_found for META_TEXT_MODEL after retries
META_TEXT_FALLBACK_MODEL=muse-spark-1.2
META_IMAGE_MODEL=muse-image-1.0
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0

# ElevenLabs (text-to-speech; Meta has no TTS model)
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Only needed if the key cannot read voices (comma-separated voice IDs)
ELEVENLABS_VOICE_IDS=

# Shown on /forgot-password (leave empty to show a generic message)
ADMIN_CONTACT_EMAIL=

# Generation policy (PostgreSQL job queue; run `npm run worker`)
GENERATION_MAX_CONCURRENCY_PER_USER=1
GENERATION_MAX_RETRIES=3
GENERATION_TIMEOUT_SECONDS=120
# Optional cap per task type. Leave empty for the default counts in lib/config/practice-types.ts (208 per plan).
GENERATION_ITEMS_PER_TASK=
# Vocabulary words taken from each practice type's generated questions (about 120 per plan)
VOCABULARY_WORDS_PER_TASK=10
GENERATION_DAILY_USER_LIMIT=

# Optional: protects POST /api/internal/worker/tick (cron-driven drain)
WORKER_TICK_SECRET=
